            "dataType": "string",
            "isHidden": true,
            "lineageTag": "51d05a53-38da-462c-aaf6-5c8b97559fd3",
            "sourceColumn": "Dummy"
          }
        ],
        "lineageTag": "de27bf58-6ab4-4db3-a813-2e730e5869a9",
        "measures": [
          {
            "name": "Matches",
            "expression": "DISTINCTCOUNT(Matches[match_id])",
            "formatString": "#,0",
            "lineageTag": "3d508e68-47a0-465e-82d6-f5f2fefeec4b"
          },
          {
            "name": "Total Runs",
            "expression": "SUM(Deliveries[total_runs])",
            "formatString": "#,0",
            "lineageTag": "b4ddc437-ba74-441f-905f-82893608766c"
          },
          {
            "name": "Wickets",
            "expression": "SUM(Deliveries[is_wicket])",
            "formatString": "#,0",
            "lineageTag": "8bc5029c-7aff-4fc0-ac3a-41242369efa4"
          },
          {
            "name": "Sixes",
            "expression": "SUM(Deliveries[is_six])",
            "formatString": "#,0",
            "lineageTag": "935580c9-fcb0-48e2-a4c9-5b46989982d7"
          },
          {
            "name": "Fours",
            "expression": "SUM(Deliveries[is_four])",
            "formatString": "#,0",
            "lineageTag": "7704eb1d-9380-4a43-b05c-71cf3ca0d234"
          },
          {
            "name": "Extras",
            "expression": "SUM(Deliveries[extras])",
            "formatString": "#,0",
            "lineageTag": "0fdf056f-ab36-4185-b3ef-ff04a20da414"
          },
          {
            "name": "Legal Balls",
            "expression": "SUM(Deliveries[is_legal])",
            "formatString": "#,0",
            "lineageTag": "05870de9-0393-46f9-a5a8-5e05baeb9a0a"
          },
          {
            "name": "Run Rate",
            "expression": "DIVIDE([Total Runs] * 6, [Legal Balls])",
            "formatString": "0.00",
            "lineageTag": "97676e72-6a25-4bbb-a176-17f856479ed2"
          },
          {
            "name": "Innings",
            "expression": "COUNTROWS(SUMMARIZE(Deliveries, Deliveries[match_id], Deliveries[innings]))",
            "formatString": "#,0",
            "lineageTag": "be5050ad-aecb-4583-9ab3-609193ea3a81"
          },
          {
            "name": "Runs per Match",
            "expression": "DIVIDE([Total Runs], [Matches])",
            "formatString": "0.0",
            "lineageTag": "9dc5472b-9b06-4e86-80b7-61fecf737935"
          },
          {
            "name": "Sixes per Match",
            "expression": "DIVIDE([Sixes], [Matches])",
            "formatString": "0.0",
            "lineageTag": "28fe8e13-5558-4886-a761-3a5c1d4a9f96"
          },
          {
            "name": "Avg Runs per Over",
            "expression": "DIVIDE([Total Runs], [Innings])",
            "formatString": "0.00",
            "lineageTag": "e06b943b-167e-4bfc-8811-e18e22b35433"
          },
          {
            "name": "Wickets per Innings",
            "expression": "DIVIDE([Wickets], [Innings])",
            "formatString": "0.00",
            "lineageTag": "987d4a11-9ec9-40b2-b1d5-3f4a58511cc3"
          },
          {
            "name": "Highest Total",
            "expression": "MAXX(SUMMARIZE(Deliveries, Deliveries[match_id], Deliveries[innings]), CALCULATE(SUM(Deliveries[total_runs])))",
            "formatString": "#,0",
            "lineageTag": "d2ffcf88-2768-4639-9c3b-efdc421a77af"
          },
          {
            "name": "Avg 1st Innings",
            "expression": "AVERAGEX(FILTER(SUMMARIZE(Deliveries, Deliveries[match_id], Deliveries[innings]), Deliveries[innings] = 1), CALCULATE(SUM(Deliveries[total_runs])))",
            "formatString": "0.0",
            "lineageTag": "164f3697-7afd-4f35-bd32-6c25a367aab3"
          },
          {
            "name": "Batter Runs",
            "expression": "SUM(Deliveries[batter_runs])",
            "formatString": "#,0",
            "lineageTag": "246b0826-7d5b-4b93-a27a-fc055127f7ef"
          },
          {
            "name": "Balls Faced",
            "expression": "SUM(Deliveries[ball_faced])",
            "formatString": "#,0",
            "lineageTag": "b5a6f931-9471-4c47-8c12-31443248b980"
          },
          {
            "name": "Strike Rate",
            "expression": "DIVIDE([Batter Runs] * 100, [Balls Faced])",
            "formatString": "0.0",
            "lineageTag": "dc036dad-9656-4a47-a441-6ecccd97c110"
          },
          {
            "name": "Batter Rank",
            "expression": "IF(HASONEVALUE(Deliveries[batter]), RANKX(ALLSELECTED(Deliveries[batter]), [Batter Runs], , DESC, Dense))",
            "formatString": "0",
            "lineageTag": "e3775a56-ba83-4bfa-bb54-bdd34c2aa4c8"
          },
          {
            "name": "Top 10 Runs",
            "expression": "IF([Batter Rank] <= 10, [Batter Runs])",
            "formatString": "#,0",
            "lineageTag": "8f28cfd8-3997-410c-94c7-085c8670e67d"
          },
          {
            "name": "Top 10 Strike Rate",
            "expression": "IF([Batter Rank] <= 10, [Strike Rate])",
            "formatString": "0.0",
            "lineageTag": "b0659bf9-96c8-4fec-bc7b-23cb89b6924c"
          },
          {
            "name": "Top 10 Fours",
            "expression": "IF([Batter Rank] <= 10, [Fours])",
            "formatString": "#,0",
            "lineageTag": "1bb40b3b-1cc6-43f2-8c20-35fa9b99c8b5"
          },
          {
            "name": "Top 10 Sixes",
            "expression": "IF([Batter Rank] <= 10, [Sixes])",
            "formatString": "#,0",
            "lineageTag": "0f043a11-f944-44ca-aebd-e91fa11afa70"
          },
          {
            "name": "Top 10 Bat Matches",
            "expression": "IF([Batter Rank] <= 10, DISTINCTCOUNT(Deliveries[match_id]))",
            "formatString": "#,0",
            "lineageTag": "fa278065-9d26-46d2-ad6b-abd3b64221d0"
          },
          {
            "name": "Bowler Wickets",
            "expression": "SUM(Deliveries[bowler_wicket])",
            "formatString": "#,0",
            "lineageTag": "3fd24154-fe93-4d7f-9d6a-4154ba06f3fb"
          },
          {
            "name": "Runs Conceded",
            "expression": "SUM(Deliveries[bowler_runs])",
            "formatString": "#,0",
            "lineageTag": "ce3106fa-fa1b-4600-bef3-07f48ef5b861"
          },
          {
            "name": "Economy",
            "expression": "DIVIDE([Runs Conceded] * 6, [Legal Balls])",
            "formatString": "0.00",
            "lineageTag": "612c489d-540a-4ed7-b566-53ab74ed6050"
          },
          {
            "name": "Dot Balls",
            "expression": "SUM(Deliveries[is_dot])",
            "formatString": "#,0",
            "lineageTag": "d32c9061-1cb7-482f-a767-d03a1503e3c6"
          },
          {
            "name": "Bowler Rank",
            "expression": "IF(HASONEVALUE(Deliveries[bowler]), RANKX(ALLSELECTED(Deliveries[bowler]), [Bowler Wickets] * 1000 - [Economy], , DESC, Dense))",
            "formatString": "0",
            "lineageTag": "eabce4c9-a859-4b01-8f68-1e444a4c16d9"
          },
          {
            "name": "Top 10 Wickets",
            "expression": "IF([Bowler Rank] <= 10, [Bowler Wickets])",
            "formatString": "#,0",
            "lineageTag": "bbc1e11b-28cf-4436-b95a-4f1ea0fcc231"
          },
          {
            "name": "Top 10 Economy",
            "expression": "IF([Bowler Rank] <= 10, [Economy])",
            "formatString": "0.00",
            "lineageTag": "97fe8e68-f87e-407c-9d54-0ec7eb55acd4"
          },
          {
            "name": "Top 10 Dots",
            "expression": "IF([Bowler Rank] <= 10, [Dot Balls])",
            "formatString": "#,0",
            "lineageTag": "877ebd83-83a5-43bc-bef0-dd6e86e94c68"
          },
          {
            "name": "Top 10 Bowl Matches",
            "expression": "IF([Bowler Rank] <= 10, DISTINCTCOUNT(Deliveries[match_id]))",
            "formatString": "#,0",
            "lineageTag": "32991b32-db36-48bd-ad33-2d1ce7da6255"
          },
          {
            "name": "Played",
            "expression": "COUNTROWS(TeamMatches)",
            "formatString": "#,0",
            "lineageTag": "f8be6045-ffe2-423e-94e3-ccda96f9470d"
          },
          {
            "name": "Won",
            "expression": "SUM(TeamMatches[won])",
            "formatString": "#,0",
            "lineageTag": "42eb185f-4502-4312-a785-e731134269a2"
          },
          {
            "name": "Lost",
            "expression": "SUM(TeamMatches[lost])",
            "formatString": "#,0",
            "lineageTag": "70fe7577-7bc4-46b4-a4e7-0c3a5be9ecbb"
          },
          {
            "name": "Tie / NR",
            "expression": "SUM(TeamMatches[no_result_or_tie])",
            "formatString": "#,0",
            "lineageTag": "c6c16a98-7509-4e30-b08a-47b84b93a14a"
          },
          {
            "name": "Win %",
            "expression": "DIVIDE([Won], [Played])",
            "formatString": "0.0%",
            "lineageTag": "e372633d-0205-43bd-b6ef-c774e5400c6a"
          },
          {
            "name": "Titles",
            "expression": "COUNTROWS(Champions)",
            "formatString": "0",
            "lineageTag": "6904fcfc-10a1-4bbc-b49b-84533080adbe"
          },
          {
            "name": "Matches with Result",
            "expression": "SUM(Matches[has_result])",
            "formatString": "#,0",
            "lineageTag": "58f14cf2-14be-4253-817b-9df37da08957"
          },
          {
            "name": "Toss Winner Won %",
            "expression": "DIVIDE(SUM(Matches[toss_winner_won]), [Matches with Result])",
            "formatString": "0.0%",
            "lineageTag": "7ef5603c-a99c-4073-ac52-c9521eaf8f6c"
          },
          {
            "name": "Chose to Field %",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(Matches), Matches[toss_decision] = \"field\"), COUNTROWS(Matches))",
            "formatString": "0.0%",
            "lineageTag": "8fa1e1df-a25a-4b57-be58-f73a77796c6b"
          },
          {
            "name": "Chasing Win %",
            "expression": "DIVIDE(SUM(Matches[chasing_team_won]), [Matches with Result])",
            "formatString": "0.0%",
            "lineageTag": "7327617c-2ca1-47f0-a50d-4fe17a17533d"
          },
          {
            "name": "Team Titles",
            "expression": "CALCULATE(COUNTROWS(Champions), TREATAS(VALUES(Teams[team]), Champions[champion]))",
            "formatString": "0",
            "lineageTag": "b8853509-1328-4b67-bc9a-dfe85af17ca2"
          },
          {
            "name": "Batter Photo",
            "dataCategory": "ImageUrl",
            "expression": "IF([Batter Rank] <= 10, LOOKUPVALUE(Players[photo], Players[player], SELECTEDVALUE(Deliveries[batter])))",
            "lineageTag": "8756de29-91dc-4a55-af57-5dedbcd94b1b"
          },
          {
            "name": "Bowler Photo",
            "dataCategory": "ImageUrl",
            "expression": "IF([Bowler Rank] <= 10, LOOKUPVALUE(Players[photo], Players[player], SELECTEDVALUE(Deliveries[bowler])))",
            "lineageTag": "96f5d4e9-5b92-4d46-914a-8989f1e69e57"
          },
          {
            "name": "Orange Cap Photo",
            "dataCategory": "ImageUrl",
            "expression": "IF([Batter Rank] = 1, LOOKUPVALUE(Players[photo], Players[player], SELECTEDVALUE(Deliveries[batter])))",
            "lineageTag": "27ab3588-fd13-4af7-bff2-eaf0cd548d81"
          },
          {
            "name": "Orange Cap Runs",
            "expression": "IF([Batter Rank] = 1, [Batter Runs])",
            "formatString": "#,0",
            "lineageTag": "2dd536ad-c956-4689-ac9a-4cc451039b88"
          },
          {
            "name": "Orange Cap SR",
            "expression": "IF([Batter Rank] = 1, [Strike Rate])",
            "formatString": "0.0",
            "lineageTag": "d4de50dd-9882-4b3c-afe2-2ad25a87a57d"
          },
          {
            "name": "Purple Cap Photo",
            "dataCategory": "ImageUrl",
            "expression": "IF([Bowler Rank] = 1, LOOKUPVALUE(Players[photo], Players[player], SELECTEDVALUE(Deliveries[bowler])))",
            "lineageTag": "917928ca-c33f-4868-bfa5-8184f287ae07"
          },
          {
            "name": "Purple Cap Wickets",
            "expression": "IF([Bowler Rank] = 1, [Bowler Wickets])",
            "formatString": "#,0",
            "lineageTag": "5612e0d7-2987-44b4-8480-127051d7319d"
          },
          {
            "name": "Purple Cap Economy",
            "expression": "IF([Bowler Rank] = 1, [Economy])",
            "formatString": "0.00",
            "lineageTag": "d68cf1f5-64ff-4cc8-bc6e-6b3abbeef5af"
          }
        ],
