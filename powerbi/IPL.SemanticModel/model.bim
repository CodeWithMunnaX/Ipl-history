      {
        "name": "Metrics",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "columns": [
          {
            "name": "Dummy",
            "dataType": "string",
            "isHidden": true,
            "lineageTag": "a99c662c-4422-4145-925a-979b402c0cd7",
            "sourceColumn": "Dummy"
          }
        ],
        "lineageTag": "a3f62ab7-5129-49ee-bc12-e7d2257207f4",
        "measures": [
          {
            "name": "Matches",
            "expression": "DISTINCTCOUNT(Matches[match_id])",
            "formatString": "#,0",
            "lineageTag": "fff868c5-a958-45c6-abd0-b5b39835fe00"
          },
          {
            "name": "Total Runs",
            "expression": "SUM(Deliveries[total_runs])",
            "formatString": "#,0",
            "lineageTag": "36368c93-bf6e-4876-a277-124a5d4140aa"
          },
          {
            "name": "Wickets",
            "expression": "SUM(Deliveries[is_wicket])",
            "formatString": "#,0",
            "lineageTag": "d55666ec-2af9-44c7-bc2c-74e5422e4ca1"
          },
          {
            "name": "Sixes",
            "expression": "SUM(Deliveries[is_six])",
            "formatString": "#,0",
            "lineageTag": "5ac9eed1-f51c-4ca9-8264-ed0e66921bb3"
          },
          {
            "name": "Fours",
            "expression": "SUM(Deliveries[is_four])",
            "formatString": "#,0",
            "lineageTag": "a166fed1-5cdf-4ee3-a4ca-adb6e06e9859"
          },
          {
            "name": "Extras",
            "expression": "SUM(Deliveries[extras])",
            "formatString": "#,0",
            "lineageTag": "96c3a0e7-b906-4706-94d9-e097dbe705d8"
          },
          {
            "name": "Legal Balls",
            "expression": "SUM(Deliveries[is_legal])",
            "formatString": "#,0",
            "lineageTag": "c488cee5-8d70-46fc-98c9-5ebab0d0fc2d"
          },
          {
            "name": "Run Rate",
            "expression": "DIVIDE([Total Runs] * 6, [Legal Balls])",
            "formatString": "0.00",
            "lineageTag": "2af3c78c-fc75-4265-8942-b6f87eaae666"
          },
          {
            "name": "Innings",
            "expression": "COUNTROWS(SUMMARIZE(Deliveries, Deliveries[match_id], Deliveries[innings]))",
            "formatString": "#,0",
            "lineageTag": "36197a21-9771-4500-b2af-962591debe2d"
          },
          {
            "name": "Runs per Match",
            "expression": "DIVIDE([Total Runs], [Matches])",
            "formatString": "0.0",
            "lineageTag": "eb9cbbf3-aee1-4d48-9c87-9a605c020109"
          },
          {
            "name": "Sixes per Match",
            "expression": "DIVIDE([Sixes], [Matches])",
            "formatString": "0.0",
            "lineageTag": "5d521c31-8636-4bb3-9a1d-a7e84f5fca61"
          },
          {
            "name": "Avg Runs per Over",
            "expression": "DIVIDE([Total Runs], [Innings])",
            "formatString": "0.00",
            "lineageTag": "7c488a3f-b48c-4734-a30c-94eec31086c0"
          },
          {
            "name": "Wickets per Innings",
            "expression": "DIVIDE([Wickets], [Innings])",
            "formatString": "0.00",
            "lineageTag": "2764542d-83a0-47e1-87d0-6f088ef7f5c8"
          },
          {
            "name": "Highest Total",
            "expression": "MAXX(SUMMARIZE(Deliveries, Deliveries[match_id], Deliveries[innings]), CALCULATE(SUM(Deliveries[total_runs])))",
            "formatString": "#,0",
            "lineageTag": "c01f0023-1e16-4b95-b409-35e2ab4813e9"
          },
          {
            "name": "Avg 1st Innings",
            "expression": "AVERAGEX(FILTER(SUMMARIZE(Deliveries, Deliveries[match_id], Deliveries[innings]), Deliveries[innings] = 1), CALCULATE(SUM(Deliveries[total_runs])))",
            "formatString": "0.0",
            "lineageTag": "c91eea95-bd64-44b2-860d-dc08a2339f80"
          },
          {
            "name": "Batter Runs",
            "expression": "SUM(Deliveries[batter_runs])",
            "formatString": "#,0",
            "lineageTag": "baaf5e4e-0764-43a2-a01e-a00b45e66386"
          },
          {
            "name": "Balls Faced",
            "expression": "SUM(Deliveries[ball_faced])",
            "formatString": "#,0",
            "lineageTag": "6f247436-dbb1-4161-81ed-29ce5fc03865"
          },
          {
            "name": "Strike Rate",
            "expression": "DIVIDE([Batter Runs] * 100, [Balls Faced])",
            "formatString": "0.0",
            "lineageTag": "93383418-7431-48cf-9138-27fde5b3cf82"
          },
          {
            "name": "Batter Rank",
            "expression": "IF(HASONEVALUE(Deliveries[batter]), RANKX(ALLSELECTED(Deliveries[batter]), [Batter Runs], , DESC, Dense))",
            "formatString": "0",
            "lineageTag": "605ab1f0-ae78-44ef-b3e9-4db133957860"
          },
          {
            "name": "Top 10 Runs",
            "expression": "IF([Batter Rank] <= 10, [Batter Runs])",
            "formatString": "#,0",
            "lineageTag": "2fb76bb0-e423-4ec9-b120-b1d171437c17"
          },
          {
            "name": "Top 10 Strike Rate",
            "expression": "IF([Batter Rank] <= 10, [Strike Rate])",
            "formatString": "0.0",
            "lineageTag": "f2676f9b-1a3f-4152-b55c-380a58d9e4ce"
          },
          {
            "name": "Top 10 Fours",
            "expression": "IF([Batter Rank] <= 10, [Fours])",
            "formatString": "#,0",
            "lineageTag": "8ee8e430-522a-4dc8-98c6-24d87eff847e"
          },
          {
            "name": "Top 10 Sixes",
            "expression": "IF([Batter Rank] <= 10, [Sixes])",
            "formatString": "#,0",
            "lineageTag": "26e3e995-04a0-4d30-9ddb-b591eb43c47a"
          },
          {
            "name": "Top 10 Bat Matches",
            "expression": "IF([Batter Rank] <= 10, DISTINCTCOUNT(Deliveries[match_id]))",
            "formatString": "#,0",
            "lineageTag": "8340c2b3-160a-4dcc-a91b-03304c64c971"
          },
          {
            "name": "Bowler Wickets",
            "expression": "SUM(Deliveries[bowler_wicket])",
            "formatString": "#,0",
            "lineageTag": "79dfa2a4-94fd-4854-9d90-5908e96027c6"
          },
          {
            "name": "Runs Conceded",
            "expression": "SUM(Deliveries[bowler_runs])",
            "formatString": "#,0",
            "lineageTag": "5589fe89-a9cc-4130-b2a9-09f5cad9db57"
          },
          {
            "name": "Economy",
            "expression": "DIVIDE([Runs Conceded] * 6, [Legal Balls])",
            "formatString": "0.00",
            "lineageTag": "cd237e2d-1188-48af-b40c-eee58cf02422"
          },
          {
            "name": "Dot Balls",
            "expression": "SUM(Deliveries[is_dot])",
            "formatString": "#,0",
            "lineageTag": "9e977f34-dca9-4e32-abeb-e458afb515af"
          },
          {
            "name": "Bowler Rank",
            "expression": "IF(HASONEVALUE(Deliveries[bowler]), RANKX(ALLSELECTED(Deliveries[bowler]), [Bowler Wickets] * 1000 - [Economy], , DESC, Dense))",
            "formatString": "0",
            "lineageTag": "2f18d2e9-87e9-4c14-bd48-9a9cae623196"
          },
          {
            "name": "Top 10 Wickets",
            "expression": "IF([Bowler Rank] <= 10, [Bowler Wickets])",
            "formatString": "#,0",
            "lineageTag": "701cd1e3-c7d1-4f52-b37e-4eb37bca9d8e"
          },
          {
            "name": "Top 10 Economy",
            "expression": "IF([Bowler Rank] <= 10, [Economy])",
            "formatString": "0.00",
            "lineageTag": "8b6021f3-ff80-43db-8529-a4a6f04f1c22"
          },
          {
            "name": "Top 10 Dots",
            "expression": "IF([Bowler Rank] <= 10, [Dot Balls])",
            "formatString": "#,0",
            "lineageTag": "77c98af4-c4ad-44a9-9276-b13b923d1d92"
          },
          {
            "name": "Top 10 Bowl Matches",
            "expression": "IF([Bowler Rank] <= 10, DISTINCTCOUNT(Deliveries[match_id]))",
            "formatString": "#,0",
            "lineageTag": "a85e3c45-d936-4dba-b1d9-3692ec467627"
          },
          {
            "name": "Played",
            "expression": "COUNTROWS(TeamMatches)",
            "formatString": "#,0",
            "lineageTag": "1eefdaf2-042a-4fe8-b027-12134e1daaa5"
          },
          {
            "name": "Won",
            "expression": "SUM(TeamMatches[won])",
            "formatString": "#,0",
            "lineageTag": "d2b9c170-b655-43a2-94cf-97caa8442103"
          },
          {
            "name": "Lost",
            "expression": "SUM(TeamMatches[lost])",
            "formatString": "#,0",
            "lineageTag": "395385d1-5d15-4cc9-acc6-d62f7d52114d"
          },
          {
            "name": "Tie / NR",
            "expression": "SUM(TeamMatches[no_result_or_tie])",
            "formatString": "#,0",
            "lineageTag": "6c7a60e2-2c32-45ce-9e0c-a65fe73193b9"
          },
          {
            "name": "Win %",
            "expression": "DIVIDE([Won], [Played])",
            "formatString": "0.0%",
            "lineageTag": "ac48ca9d-ee03-4e63-bbdb-e1ba362319d8"
          },
          {
            "name": "Titles",
            "expression": "COUNTROWS(Champions)",
            "formatString": "0",
            "lineageTag": "a97a5e0d-3d56-4982-bf12-f3333a7f59b4"
          },
          {
            "name": "Matches with Result",
            "expression": "SUM(Matches[has_result])",
            "formatString": "#,0",
            "lineageTag": "ea11d1fc-b492-4f9b-ad50-896880907b83"
          },
          {
            "name": "Toss Winner Won %",
            "expression": "DIVIDE(SUM(Matches[toss_winner_won]), [Matches with Result])",
            "formatString": "0.0%",
            "lineageTag": "cd59d20f-9506-44bb-86f0-2820e4ce1621"
          },
          {
            "name": "Chose to Field %",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(Matches), Matches[toss_decision] = \"field\"), COUNTROWS(Matches))",
            "formatString": "0.0%",
            "lineageTag": "17ba2564-12ea-44f0-b021-3f18323bfdd9"
          },
          {
            "name": "Chasing Win %",
            "expression": "DIVIDE(SUM(Matches[chasing_team_won]), [Matches with Result])",
            "formatString": "0.0%",
            "lineageTag": "e2205e4a-dbe6-46dc-958c-c925da7fb6f8"
          }
        ],
        "partitions": [
          {
            "name": "Metrics",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = #table(type table [Dummy = text], {})",
                "in",
                "    Source"
              ],
              "type": "m"
            }
          }
        ]
